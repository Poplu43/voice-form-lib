# Copy this file to .env.local (or .env) and fill in real values before `yarn dev`.
# Never commit the filled-in copy — .gitignore excludes .env and .env.* by design.
#
# ⚠️  Everything VITE_-prefixed is inlined into the BROWSER BUNDLE by Vite and is
#     readable by anyone who loads the page. Use these for local development only.
#     For deployed environments, proxy through a backend and use the unprefixed
#     server-side variables at the bottom of this file instead.

# ─── Sarvam AI speech: STT + streaming TTS (v2) ──────────────────────────────
VITE_SARVAM_API_KEY=your-sarvam-api-key

# ─── Amazon Bedrock: answer routing + label/option translation ───────────────
VITE_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
VITE_BEDROCK_REGION=ap-south-1

# Short-lived AWS IAM credentials with permission to invoke Amazon Bedrock.
# Prefer temporary STS credentials over long-lived IAM user keys.
VITE_AWS_ACCESS_KEY_ID=your-aws-access-key-id
VITE_AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Required when using temporary credentials issued by STS.
VITE_AWS_SESSION_TOKEN=

# ─── Azure Speech (v1 legacy path only) ─────────────────────────────────────
VITE_AZURE_SPEECH_KEY=
VITE_AZURE_SPEECH_REGION=

# ─── Langfuse observability (optional) ──────────────────────────────────────
# Keys from cloud.langfuse.com → Settings → API Keys
VITE_LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-public-key
VITE_LANGFUSE_SECRET_KEY=sk-lf-replace-with-secret-key
VITE_LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─── Server-side only (Bedrock proxy plugin) ────────────────────────────────
# Used by server/bedrockProxyPlugin.ts. These are NOT exposed to the browser —
# this is the recommended way to hold credentials for anything deployed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=
BEDROCK_REGION=
BEDROCK_PROXY_DEBUG=

# ─── Dev server (docker-compose / vite) ─────────────────────────────────────
DEMO_ROOT=demo-myscheme
HOST_PORT=3045
DEV_SERVER_USE_HTTPS=
DEV_SERVER_SSL_KEY=
DEV_SERVER_SSL_CERT=
DEV_SERVER_SSL_CA=
