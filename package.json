{
  "name": "@myscheme/voice-form-filling",
  "version": "0.3.5",
  "description": "Voice-driven form filling library. v2 uses Sarvam AI (live STT + streaming TTS) with Amazon Bedrock for answer routing and label/option translation. v1 (Azure Speech) is preserved frozen as legacy.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "setup": "node scripts/setup-assets.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite --port 3045",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.525.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "html-encoding-sniffer": "2.0.1",
    "langfuse": "^3.38.20",
    "microsoft-cognitiveservices-speech-sdk": "^1.47.0",
    "sarvamai": "^1.1.6",
    "socket.io-client": "^4.7.2",
    "wavtools": "^0.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^24.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vite": "^5.0.11",
    "vitest": "^3.2.4"
  }
}
